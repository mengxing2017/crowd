# 使用 URL 安全字符生成密码（例如 openssl rand -hex 24）。
POSTGRES_PASSWORD=
API_IMAGE=crowd-api:local
WEB_IMAGE=crowd-web:local
WEB_PORT=8088

# 以下仅在 API 服务端配置；不要写入前端、小程序或日志。
CROWD_WECHAT_APP_ID=
CROWD_WECHAT_APP_SECRET=
# 仅空环境首次运维初始化使用 AppID:OpenID；建档后移除。
CROWD_BOOTSTRAP_PLATFORM_ID=
CROWD_SESSION_SECONDS=7200
# 普通二维码对应的 HTTPS Web 入口，非官方小程序码。
CROWD_PROMOTION_ORIGIN=

# 外置数据库首次初始化管理员：两项同时配置，密码 12–128 字节；创建后移除。
# 不覆盖已有账号密码或岗位权限；开发用嵌入式 PG 自动创建独立临时 admin。
CROWD_BOOTSTRAP_ADMIN_USERNAME=
CROWD_BOOTSTRAP_ADMIN_PASSWORD=
