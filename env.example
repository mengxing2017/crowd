# 数据库密码原样传入 SQLx，支持 @ 等字符；可用 openssl rand -hex 24 生成。
# Compose .env 中含 $ 的密码建议用单引号包裹，避免变量插值。
POSTGRES_PASSWORD=
API_IMAGE=crowd-api:local
WEB_IMAGE=crowd-web:local
WEB_PORT=8088

# 以下仅在 API 服务端配置；不要写入前端、小程序或日志。
CROWD_WECHAT_APP_ID=
CROWD_WECHAT_APP_SECRET=
# 仅空环境首次运维初始化使用 AppID:OpenID；建档后移除。
CROWD_BOOTSTRAP_PLATFORM_ID=
CROWD_SESSION_SECONDS=7200
# 普通二维码对应的 HTTPS Web 入口，非官方小程序码。
CROWD_PROMOTION_ORIGIN=

# 外置数据库首次初始化管理员：两项同时配置，密码 12–128 字节；创建后移除。
# 不覆盖已有账号密码或岗位权限；开发用嵌入式 PG 自动创建独立临时 admin。
CROWD_BOOTSTRAP_ADMIN_USERNAME=
CROWD_BOOTSTRAP_ADMIN_PASSWORD=

# 外部 API 进程/独立容器可使用分项配置（仓库 Compose 固定连接自身 postgres，
# 不读取下面的覆盖值；.env 不会被 API 进程自动加载）：
# CROWD_DATABASE_HOST=127.0.0.1
# CROWD_DATABASE_PORT=5432
# CROWD_DATABASE_NAME=crowd
# CROWD_DATABASE_USER=crowd
# CROWD_DATABASE_PASSWORD=实际原始密码
# CROWD_DATABASE_SSL_MODE=prefer
# 兼容完整 URL：非空 CROWD_DATABASE_URL 优先于以上分项；密码特殊字符须百分号编码。
