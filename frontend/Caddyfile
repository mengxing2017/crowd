{$CROWD_WEB_LISTEN::80} {
    handle /api/* {
        reverse_proxy {$CROWD_API_UPSTREAM:api:8080}
    }
    handle /healthz {
        reverse_proxy {$CROWD_API_UPSTREAM:api:8080}
    }
    handle /readyz {
        reverse_proxy {$CROWD_API_UPSTREAM:api:8080}
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
